{
  "name": "@cotali/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "check": "cross-env DATABASE_URL=postgresql://cotali:cotali@localhost:5432/cotali DATABASE_URL_UNPOOLED=postgresql://cotali:cotali@localhost:5432/cotali prisma validate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.2"
  }
}
