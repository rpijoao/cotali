PORT=3333
DATABASE_URL="postgresql://cotali:cotali@localhost:5432/cotali?schema=public"
DATABASE_URL_UNPOOLED="postgresql://cotali:cotali@localhost:5432/cotali?schema=public"

# Apenas para desenvolvimento local. Produção exige OIDC.
AUTH_MODE=development

# Necessário quando AUTH_MODE não for development.
OIDC_ISSUER="https://identity.example.com/"
OIDC_AUDIENCE="cotali-api"
OIDC_JWKS_URL="https://identity.example.com/.well-known/jwks.json"
