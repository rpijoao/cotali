PORT=3333
DATABASE_URL="postgresql://cotali:cotali@localhost:5432/cotali?schema=public"
DATABASE_URL_UNPOOLED="postgresql://cotali:cotali@localhost:5432/cotali?schema=public"

# Better Auth usa sessões persistidas no PostgreSQL em todos os ambientes.
BETTER_AUTH_URL=http://localhost:3333
BETTER_AUTH_SECRET="gere-um-segredo-aleatorio-com-pelo-menos-32-bytes"
WEB_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Origens permitidas para callback/origin do OAuth, separadas por vírgula.
# Em produção, configure a lista exata do ambiente; curingas são proibidos.
AUTH_TRUSTED_ORIGINS=http://localhost:3000,cotali://
# SameSite padrão para o cookie web. Use none somente com HTTPS e revisão de CSRF.
AUTH_COOKIE_SAME_SITE=lax
PRIVACY_POLICY_VERSION=2026-09-06
# Quantos proxies reversos confiáveis existem entre o cliente e a API.
# Use 0 quando a API recebe conexões diretamente.
TRUSTED_PROXY_HOPS=0

# Provedores sociais. Os dois pares são obrigatórios em produção.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Remetente autenticado no Resend. Nunca exponha RESEND_API_KEY no mobile.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Cotali <contato@seudominio.com>"

# Groq fica somente no backend; nunca exponha esta chave no app mobile.
GROQ_API_KEY=""
GROQ_TRANSCRIPTION_MODEL="whisper-large-v3-turbo"
GROQ_EXTRACTION_MODEL="openai/gpt-oss-20b"
# Opcional: segunda passagem de comandos de edição; por padrão usa o extrator.
GROQ_COMMAND_MODEL="openai/gpt-oss-20b"

# Benchmark local opt-in: o worker arquiva áudios fictícios somente quando
# esta pasta é definida, VOICE_BENCHMARK_RUN=true e NODE_ENV não é production.
# VOICE_BENCHMARK_AUDIO_DIR="../../tmp/voice-benchmark/audio"
# VOICE_BENCHMARK_RUN="true"
# VOICE_BENCHMARK_COMBINATIONS="whisper-large-v3-turbo|openai/gpt-oss-20b,whisper-large-v3|openai/gpt-oss-20b,whisper-large-v3-turbo|openai/gpt-oss-120b"
