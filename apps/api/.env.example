PORT=3333
DATABASE_URL="postgresql://cotali:cotali@localhost:5432/cotali?schema=public"
DATABASE_URL_UNPOOLED="postgresql://cotali:cotali@localhost:5432/cotali?schema=public"

# Apenas para desenvolvimento local. Produção exige OIDC.
AUTH_MODE=development

# Groq fica somente no backend; nunca exponha esta chave no app mobile.
GROQ_API_KEY=""
GROQ_TRANSCRIPTION_MODEL="whisper-large-v3-turbo"
GROQ_EXTRACTION_MODEL="openai/gpt-oss-20b"
# Opcional: segunda passagem de comandos de edição; por padrão usa o extrator.
GROQ_COMMAND_MODEL="openai/gpt-oss-20b"

# Benchmark local opt-in: o worker arquiva áudios fictícios somente quando
# esta pasta é definida, VOICE_BENCHMARK_RUN=true e NODE_ENV não é production.
# VOICE_BENCHMARK_AUDIO_DIR="../../tmp/voice-benchmark/audio"
# VOICE_BENCHMARK_RUN="true"
# VOICE_BENCHMARK_COMBINATIONS="whisper-large-v3-turbo|openai/gpt-oss-20b,whisper-large-v3|openai/gpt-oss-20b,whisper-large-v3-turbo|openai/gpt-oss-120b"

# Necessário quando AUTH_MODE não for development.
OIDC_ISSUER="https://identity.example.com/"
OIDC_AUDIENCE="cotali-api"
OIDC_JWKS_URL="https://identity.example.com/.well-known/jwks.json"
